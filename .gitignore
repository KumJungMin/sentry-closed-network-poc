# Local secrets and machine-specific overrides
.env
.env.*
!.env.example
!.env.*.example

# Package manager and frontend build output
node_modules/
dist/
coverage/
__pycache__/
.business-feature-builder/
.react-ai-reviewer/

# Logs and editor/OS metadata
*.log
.DS_Store
.idea/
.vscode/

# Large offline artifacts must not be committed accidentally
*.tar
*.tar.gz
*.tgz
offline-artifacts/

# Local Sentry runtime checkout and generated configuration
.runtime/

# Vendored Self-hosted Sentry runtime data, if this path is chosen in Phase 2
vendor/self-hosted/.env.custom
