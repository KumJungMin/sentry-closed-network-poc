[
  {
    "title": "PoC - 도메인 프론트 현황",
    "projectSlugs": ["frontend-membership", "frontend-remittance", "frontend-payment"],
    "environment": [],
    "period": "14d",
    "filters": {},
    "widgets": [
      {
        "title": "전체 시스템 오류",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "", "fields": ["count()"], "aggregates": ["count()"], "columns": [], "fieldAliases": ["오류"], "orderby": ""}],
        "layout": {"x": 0, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "영향을 받은 사용자",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "has:user", "fields": ["count_unique(user)"], "aggregates": ["count_unique(user)"], "columns": [], "fieldAliases": ["사용자"], "orderby": ""}],
        "layout": {"x": 2, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "세션 리플레이가 있는 오류",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "has:replayId", "fields": ["count()"], "aggregates": ["count()"], "columns": [], "fieldAliases": ["리플레이 오류"], "orderby": ""}],
        "layout": {"x": 4, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "서비스별 시스템 오류",
        "displayType": "categorical_bar",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 10,
        "queries": [{"name": "", "conditions": "has:service", "fields": ["service", "count()"], "aggregates": ["count()"], "columns": ["service"], "fieldAliases": ["서비스", "오류"], "orderby": "-count()"}],
        "layout": {"x": 0, "y": 1, "w": 2, "h": 2, "minH": 2}
      },
      {
        "title": "플로우 단계별 시스템 오류",
        "displayType": "categorical_bar",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:flow.step", "fields": ["flow.step", "count()"], "aggregates": ["count()"], "columns": ["flow.step"], "fieldAliases": ["플로우 단계", "오류"], "orderby": "-count()"}],
        "layout": {"x": 2, "y": 1, "w": 2, "h": 2, "minH": 2}
      },
      {
        "title": "오류 코드별 시스템 오류",
        "displayType": "categorical_bar",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:error_code", "fields": ["error_code", "count()"], "aggregates": ["count()"], "columns": ["error_code"], "fieldAliases": ["오류 코드", "오류"], "orderby": "-count()"}],
        "layout": {"x": 4, "y": 1, "w": 2, "h": 2, "minH": 2}
      },
      {
        "title": "URL별 화면 성능",
        "displayType": "table",
        "widgetType": "spans",
        "interval": "1h",
        "limit": 20,
        "queries": [{"name": "", "conditions": "is_transaction:true", "fields": ["transaction", "count()", "avg(span.duration)", "p95(span.duration)"], "aggregates": ["count()", "avg(span.duration)", "p95(span.duration)"], "columns": ["transaction"], "fieldAliases": ["URL", "진입 수", "평균", "P95"], "orderby": "-p95(span.duration)"}],
        "layout": {"x": 0, "y": 3, "w": 3, "h": 3, "minH": 2}
      },
      {
        "title": "배포 버전별 시스템 오류",
        "displayType": "table",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:release", "fields": ["release", "count()", "count_unique(user)"], "aggregates": ["count()", "count_unique(user)"], "columns": ["release"], "fieldAliases": ["배포 버전", "오류", "사용자"], "orderby": "-count()"}],
        "layout": {"x": 3, "y": 3, "w": 3, "h": 3, "minH": 2}
      },
      {
        "title": "플로우별 이탈률",
        "displayType": "table",
        "widgetType": "spans",
        "interval": "5m",
        "limit": 20,
        "queries": [{"name": "", "conditions": "span.op:poc.flow.snapshot snapshot.type:domain_flow_funnel", "fields": ["timestamp", "service", "flow.slug", "tags[flow.step_index,number]", "flow.step_display", "flow.page_path", "tags[flow.total_attempts,number]", "tags[flow.completed_attempts,number]", "tags[flow.reached,number]", "tags[flow.progressed,number]", "tags[flow.drop_off,number]", "tags[flow.pending_drop_off,number]", "tags[flow.drop_off_rate,number]"], "aggregates": [], "columns": ["timestamp", "service", "flow.slug", "tags[flow.step_index,number]", "flow.step_display", "flow.page_path", "tags[flow.total_attempts,number]", "tags[flow.completed_attempts,number]", "tags[flow.reached,number]", "tags[flow.progressed,number]", "tags[flow.drop_off,number]", "tags[flow.pending_drop_off,number]", "tags[flow.drop_off_rate,number]"], "fieldAliases": ["집계 시각", "서비스", "플로우", "단계 순서", "화면", "URL", "전체 시도", "완료", "도달", "다음 단계 이동", "이탈 확정", "이탈 판단 대기", "이탈률 (%)"], "orderby": "-timestamp"}],
        "layout": {"x": 0, "y": 6, "w": 6, "h": 4, "minH": 3}
      }
    ]
  },
  {
    "title": "PoC - 사용자 플로우 조사",
    "projectSlugs": ["frontend-membership", "frontend-remittance", "frontend-payment"],
    "environment": [],
    "period": "24h",
    "filters": {},
    "widgets": [
      {
        "title": "최근 플로우 진행 로그",
        "displayType": "table",
        "widgetType": "logs",
        "interval": "5m",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:flow.event", "fields": ["timestamp", "user.id", "service", "flow.slug", "flow.step", "flow.event", "flow.attempt_id", "page.path"], "aggregates": [], "columns": ["timestamp", "user.id", "service", "flow.slug", "flow.step", "flow.event", "flow.attempt_id", "page.path"], "fieldAliases": ["시각", "사용자 ID", "서비스", "플로우", "단계", "행동", "시도 ID", "URL"], "orderby": "-timestamp"}],
        "layout": {"x": 0, "y": 0, "w": 6, "h": 4, "minH": 3}
      },
      {
        "title": "플로우 이벤트별 로그",
        "displayType": "categorical_bar",
        "widgetType": "logs",
        "interval": "5m",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:flow.event", "fields": ["flow.event", "count(message)"], "aggregates": ["count(message)"], "columns": ["flow.event"], "fieldAliases": ["행동", "로그"], "orderby": "-count(message)"}],
        "layout": {"x": 0, "y": 4, "w": 3, "h": 2, "minH": 2}
      },
      {
        "title": "플로우 단계별 로그",
        "displayType": "categorical_bar",
        "widgetType": "logs",
        "interval": "5m",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:flow.step", "fields": ["flow.step", "count(message)"], "aggregates": ["count(message)"], "columns": ["flow.step"], "fieldAliases": ["단계", "로그"], "orderby": "-count(message)"}],
        "layout": {"x": 3, "y": 4, "w": 3, "h": 2, "minH": 2}
      },
      {
        "title": "사용자·세션 리플레이가 연결된 오류",
        "displayType": "table",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 20,
        "queries": [{"name": "", "conditions": "has:user has:replayId", "fields": ["id", "timestamp", "title", "user", "flow.slug", "flow.step", "flow.attempt_id", "error_code", "replayId"], "aggregates": [], "columns": ["id", "timestamp", "title", "user", "flow.slug", "flow.step", "flow.attempt_id", "error_code", "replayId"], "fieldAliases": ["이벤트 ID", "시각", "오류", "사용자", "플로우", "단계", "시도 ID", "오류 코드", "Replay ID"], "orderby": "-timestamp"}],
        "layout": {"x": 0, "y": 6, "w": 6, "h": 3, "minH": 2}
      }
    ]
  }
]
