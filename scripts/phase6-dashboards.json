[
  {
    "title": "PoC - Frontend Stability",
    "projects": [2],
    "environment": [],
    "period": "14d",
    "filters": {},
    "widgets": [
      {
        "title": "Total Errors",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "", "fields": ["count()"], "aggregates": ["count()"], "columns": [], "fieldAliases": [], "orderby": ""}],
        "layout": {"x": 0, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "Affected Users",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "", "fields": ["count_unique(user)"], "aggregates": ["count_unique(user)"], "columns": [], "fieldAliases": [], "orderby": ""}],
        "layout": {"x": 2, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "Unresolved Issues",
        "displayType": "big_number",
        "widgetType": "error-events",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "is:unresolved", "fields": ["count_unique(issue)"], "aggregates": ["count_unique(issue)"], "columns": [], "fieldAliases": [], "orderby": ""}],
        "layout": {"x": 4, "y": 0, "w": 2, "h": 1, "minH": 1}
      },
      {
        "title": "New and Resolved Issues",
        "displayType": "bar",
        "widgetType": "issue",
        "interval": "1h",
        "queries": [{"name": "", "conditions": "", "fields": ["count(new_issues)", "count(resolved_issues)"], "aggregates": ["count(new_issues)", "count(resolved_issues)"], "columns": [], "fieldAliases": ["New", "Resolved"], "orderby": ""}],
        "layout": {"x": 0, "y": 1, "w": 6, "h": 2, "minH": 2}
      },
      {
        "title": "Browser Errors",
        "displayType": "categorical_bar",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 10,
        "queries": [{"name": "", "conditions": "has:browser.name", "fields": ["browser.name", "count()"], "aggregates": ["count()"], "columns": ["browser.name"], "fieldAliases": ["Browser", "Errors"], "orderby": "-count()"}],
        "layout": {"x": 0, "y": 3, "w": 3, "h": 2, "minH": 2}
      },
      {
        "title": "Errors by Release",
        "displayType": "line",
        "widgetType": "error-events",
        "interval": "1h",
        "limit": 5,
        "legendType": "breakdown",
        "queries": [{"name": "", "conditions": "has:release", "fields": ["release", "count()"], "aggregates": ["count()"], "columns": ["release"], "fieldAliases": ["Release", "Errors"], "orderby": "-count()"}],
        "layout": {"x": 3, "y": 3, "w": 3, "h": 2, "minH": 2}
      }
    ]
  },
